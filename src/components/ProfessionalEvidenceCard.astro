---
import type { ExperienceItem } from '../data/experience';
import type { Locale } from '../i18n';
import { localizedPath } from '../i18n';
import { t } from '../i18n/translations';

interface Props {
  item: ExperienceItem;
  locale: Locale;
}

const { item, locale } = Astro.props;
const copy = t(locale);
---

<article class="professional-evidence-card">
  <p class="eyebrow">
    {item.client} · {item.period}
  </p>
  <h3>{item.title[locale]}</h3>
  <dl>
    <div>
      <dt>{copy.home.problemLabel}</dt>
      <dd>{item.summary[locale]}</dd>
    </div>
    <div>
      <dt>{copy.home.contributionLabel}</dt>
      <dd>{item.contribution[locale]}</dd>
    </div>
  </dl>
  <ul class="tag-list" aria-label={copy.aria.technologies}>
    {item.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <a class="text-link" href={`${localizedPath(locale, 'experience')}#${item.id}`}>
    {copy.viewExperience}<span aria-hidden="true">→</span>
  </a>
</article>
