---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { experienceTimeline, developingExperience } from '../data/experience';
import { career } from '../data/career';
import { projects } from '../data/projects';
import { localizedAlternates, localizedPath, type Locale } from '../i18n';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const featured = projects.filter((project) => project.kind === 'professional');
---

<BaseLayout
  {locale}
  title={copy.nav.experience}
  description={copy.experience.intro}
  alternates={localizedAlternates('experience')}
  currentPath={localizedPath(locale, 'experience')}
>
  <section class="page-hero section-shell experience-hero">
    <p class="eyebrow">{copy.experience.eyebrow}</p>
    <h1>{copy.experience.title}</h1>
    <p class="lede">{copy.experience.intro}</p>
    <div class="role-banner">
      <div>
        <span class="eyebrow">{career.currentRole.period}</span>
        <h2>{career.currentRole.title}</h2>
        <p>{career.currentRole.company} · {copy.about.locationTitle}: Shanghai, China</p>
      </div>
      <p>{career.positioning[locale]}</p>
    </div>
  </section>

  <section class="section section-shell">
    <header class="section-heading">
      <p class="eyebrow">01 / {copy.experience.featured}</p>
      <h2>{copy.experience.featured}</h2>
    </header>
    <div class="project-grid professional-grid">
      {featured.map((project) => <ProjectCard project={project} {locale} />)}
    </div>
  </section>

  <section class="section section-shell section-tint" id="timeline">
    <header class="section-heading split-heading">
      <div>
        <p class="eyebrow">02 / {copy.experience.timeline}</p>
        <h2>{copy.experience.timeline}</h2>
      </div>
      <p>{career.experienceIntro[locale]}</p>
    </header>
    <div class="experience-timeline">
      {
        experienceTimeline.map((item, index) => (
          <article class="experience-item" id={item.id}>
            <div class="experience-marker" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="experience-item-main">
              <div class="experience-item-heading">
                <div>
                  {item.period && <span class="eyebrow">{item.period}</span>}
                  <h3>{item.title[locale]}</h3>
                  {item.client && <p class="experience-client">{item.client}</p>}
                </div>
                <span class="maturity-label">{copy.maturity[item.maturity]}</span>
              </div>
              <p>{item.summary[locale]}</p>
              <p class="experience-contribution">
                <strong>{copy.home.professionalTitle}:</strong> {item.contribution[locale]}
              </p>
              <ul class="tag-list experience-tags" aria-label={copy.aria.technologies}>
                {item.technologies.map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>
              {item.caseStudySlug && (
                <a class="text-link" href={localizedPath(locale, `projects/${item.caseStudySlug}`)}>
                  {copy.experience.readCase}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-shell">
    <header class="section-heading split-heading">
      <div>
        <p class="eyebrow">03 / {copy.experience.developing}</p>
        <h2>{copy.experience.developing}</h2>
      </div>
      <p>{copy.experience.developingIntro}</p>
    </header>
    <div class="developing-grid">
      {
        developingExperience.map((item) => (
          <article class="developing-card">
            <div class="experience-item-heading">
              <h3>{item.title[locale]}</h3>
              <span class="maturity-label">{copy.maturity[item.maturity]}</span>
            </div>
            <p>{item.summary[locale]}</p>
            <p class="experience-contribution">{item.contribution[locale]}</p>
            <ul class="tag-list experience-tags" aria-label={copy.aria.technologies}>
              {item.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-shell section-tint">
    <div class="experience-footer-grid">
      <article>
        <p class="eyebrow">{copy.experience.roleGrowth}</p>
        <p>{career.currentRole.growth[locale]}</p>
      </article>
      <article>
        <p class="eyebrow">{copy.about.languagesTitle}</p>
        <ul class="compact-list">{copy.about.languages.map((language) => <li>{language}</li>)}</ul>
      </article>
      <article>
        <p class="eyebrow">{copy.about.locationTitle}</p>
        <p>
          {copy.about.locationTitle}: Shanghai, China<br /><span class="panel-note"
            >{copy.contact.intro}</span
          >
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
