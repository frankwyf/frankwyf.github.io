---
import BaseLayout from '../layouts/BaseLayout.astro';
import { career } from '../data/career';
import { certifications, site } from '../data/site';
import { localizedAlternates, localizedPath, type Locale } from '../i18n';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<BaseLayout
  locale={locale}
  title={copy.nav.about}
  description={copy.about.paragraphs[0]}
  alternates={localizedAlternates('about')}
  currentPath={localizedPath(locale, 'about')}
>
  <section class="page-hero section-shell about-hero">
    <div><p class="eyebrow">{copy.about.eyebrow}</p><h1>{copy.about.title}</h1></div>
    <div class="about-copy">
      {copy.about.paragraphs.slice(0, 4).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section section-shell career-section">
    <header class="section-heading">
      <p class="eyebrow">01 / {copy.about.experienceTitle}</p><h2>{copy.about.experienceTitle}</h2>
    </header>
    <article class="timeline-card">
      <div>
        <span class="eyebrow">{career.currentRole.period}</span><h3>
          {career.currentRole.title}
        </h3><p>{career.currentRole.company}</p>
      </div>
      <div>
        <p>{career.experienceIntro[locale]}</p><ul class="evidence-list">
          {career.experienceHighlights[locale].map((item) => <li>{item}</li>)}
        </ul>
        <p class="role-growth">
          <strong>{copy.experience.roleGrowth}:</strong>
          {career.currentRole.growth[locale]}
        </p>
      </div>
    </article>
    <a class="button secondary section-action" href={localizedPath(locale, 'experience')}
      >{copy.experience.viewAll} →</a
    >
  </section>

  <section class="section section-shell section-tint">
    <header class="section-heading">
      <p class="eyebrow">02 / {copy.about.evidenceTitle}</p><h2>{copy.about.evidenceTitle}</h2>
    </header>
    <div class="evidence-grid">
      {
        career.evidence[locale].map(([heading, text]) => (
          <article>
            <>
              <h3>{heading}</h3>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-shell about-grid">
    <article class="info-panel">
      <p class="eyebrow">{copy.about.educationTitle}</p><p>{career.education[locale]}</p>
    </article>
    <article class="info-panel">
      <p class="eyebrow">{copy.about.languagesTitle}</p><ul>
        {copy.about.languages.map((language) => <li>{language}</li>)}
      </ul>
    </article>
    <article class="info-panel">
      <p class="eyebrow">{copy.about.certificationsTitle}</p><ul>
        {
          certifications.map((certification) => (
            <li>
              <>
                <strong>{certification.name}</strong>
                <span class:list={{ 'status-in-progress': certification.status === 'In progress' }}>
                  {certification.issuer} · {certification.status}
                </span>
              </>
            </li>
          ))
        }
      </ul>
    </article>
    <article class="info-panel">
      <p class="eyebrow">{copy.about.locationTitle}</p><p class="panel-large">
        {site.location[locale]}<br /><span class="panel-note">{site.availability[locale]}</span>
      </p>
    </article>
  </section>
</BaseLayout>
