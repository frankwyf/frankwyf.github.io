---
import type { Project } from '../data/projects';
import { projectHref } from '../data/projects';
import type { Locale } from '../i18n';
import { t } from '../i18n/translations';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const copy = t(locale);
const href = projectHref(project, locale);
const external = project.kind === 'engineering';
const actionLabel =
  project.kind === 'professional'
    ? copy.viewExperience
    : project.kind === 'flagship'
      ? copy.viewCase
      : copy.viewProject;
const maturityLabel = copy.maturity[project.maturity];
---

<article
  class:list={[
    'project-card',
    { flagship: project.kind === 'flagship', professional: project.kind === 'professional' },
  ]}
>
  <div class="project-card-topline">
    <div class="project-labels">
      <span class:list={['status-label', { private: project.visibility !== 'public-source' }]}>
        {
          project.kind === 'professional'
            ? copy.professionalExperience
            : project.visibility === 'private-source'
              ? copy.privateSource
              : copy.publicSource
        }
      </span>
      <span class="maturity-label">{maturityLabel}</span>
    </div>
    <span class="project-index" aria-hidden="true">
      {project.kind === 'professional' ? 'P' : project.kind === 'flagship' ? 'F' : 'E'}
    </span>
  </div>
  <h3>{project.title}</h3>
  {
    (project.client || project.period) && (
      <p class="project-meta">
        {project.client && (
          <span>
            {copy.clientLabel}: {project.client}
          </span>
        )}
        {project.period && (
          <span>
            {copy.periodLabel}: {project.period}
          </span>
        )}
      </p>
    )
  }
  <p>{project.summary[locale]}</p>
  <p class="project-outcome">{project.outcome[locale]}</p>
  <ul class="tag-list" aria-label={copy.aria.technologies}>
    {project.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <a
    class="text-link"
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'external noopener' : undefined}
    aria-label={`${actionLabel}: ${project.title}`}
  >
    {actionLabel}
    <span aria-hidden="true">{external ? '↗' : '→'}</span>
  </a>
</article>
