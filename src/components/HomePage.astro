---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
import { career } from '../data/career';
import { localizedAlternates, localizedPath, type Locale } from '../i18n';
import { t } from '../i18n/translations';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const professional = projects.filter((project) => project.kind === 'professional');
const flagships = projects.filter((project) => project.kind === 'flagship');
const engineering = projects.filter((project) => project.kind === 'engineering').slice(0, 3);
---

<BaseLayout
  {locale}
  title={site.name}
  description={copy.home.intro}
  alternates={localizedAlternates()}
  currentPath={localizedPath(locale)}
>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">{copy.home.eyebrow}</p>
      <p class="identity">Yifan Wang <span>· {site.englishName}</span></p>
      <h1>{copy.home.title}</h1>
      <p class="lede">{copy.home.intro}</p>
      <div class="button-row">
        <a class="button primary" href="#professional-evidence">{copy.home.projectsCta}</a>
        <a class="button secondary" href={localizedPath(locale, 'experience')}
          >{copy.nav.experience}</a
        >
      </div>
      <div class="social-row">
        <a href={site.github} rel="me external">GitHub ↗</a>
        <a href={site.linkedin} rel="me external">LinkedIn ↗</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <p class="availability-line">
        <span aria-hidden="true"></span>{site.location[locale]} · {site.availability[locale]}
      </p>
    </div>
    <aside class="professional-snapshot" aria-label={copy.home.snapshotTitle}>
      <p class="eyebrow">{copy.home.snapshotTitle}</p>
      <strong>{career.currentRole.company}</strong>
      <span>{career.currentRole.title}</span>
      <span>{career.currentRole.period}</span>
      <ul>
        <li>2+ years enterprise engineering</li>
        <li>Python / SQL / .NET</li>
        <li>{copy.home.snapshotAi}</li>
        <li>EN · 日本語 · 中文</li>
      </ul>
    </aside>
  </section>

  <section class="proof-strip section-shell" aria-label={copy.home.snapshotTitle}>
    <div><strong>2+</strong><span>years enterprise engineering</span></div>
    <div><strong>1</strong><span>end-to-end customer delivery</span></div>
    <div><strong>3</strong><span>AWS certifications earned</span></div>
    <div><strong>3</strong><span>working languages</span></div>
  </section>

  <section class="section section-shell" id="professional-evidence">
    <header class="section-heading split-heading">
      <div>
        <p class="eyebrow">01 / {copy.home.professionalTitle}</p>
        <h2>{copy.home.professionalTitle}</h2>
      </div>
      <p>{career.experienceIntro[locale]}</p>
    </header>
    <div class="project-grid professional-grid">
      {professional.map((project) => <ProjectCard project={project} {locale} />)}
    </div>
    <ul class="evidence-list">
      {career.experienceHighlights[locale].map((item) => <li>{item}</li>)}
    </ul>
    <a class="button secondary section-action" href={localizedPath(locale, 'experience')}
      >{copy.experience.viewAll} →</a
    >
  </section>

  <section class="section section-shell section-tint">
    <header class="section-heading split-heading">
      <div>
        <p class="eyebrow">02 / {copy.home.flagshipTitle}</p><h2>{copy.home.flagshipTitle}</h2>
      </div>
      <p>{copy.home.flagshipIntro}</p>
    </header>
    <div class="project-grid flagship-grid">
      {flagships.map((project) => <ProjectCard {project} {locale} />)}
    </div>
  </section>

  <section class="section section-shell" id="selected-work">
    <header class="section-heading">
      <p class="eyebrow">03 / {copy.home.selectedTitle}</p><h2>{copy.home.selectedTitle}</h2>
    </header>
    <div class="project-grid">
      {engineering.map((project) => <ProjectCard {project} {locale} />)}
    </div>
    <a class="button secondary section-action" href={localizedPath(locale, 'projects')}
      >{copy.home.allProjects} →</a
    >
  </section>

  <section class="closing-section section-shell">
    <p class="eyebrow">04 / {copy.home.contactTitle}</p><h2>{copy.home.closing}</h2>
    <a class="button primary" href={`mailto:${site.email}`}>{site.email}</a>
  </section>
</BaseLayout>
