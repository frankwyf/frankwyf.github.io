---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedAlternates, localizedPath, type Locale } from '../i18n';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<BaseLayout
  locale={locale}
  title={copy.nav.ai}
  description={copy.ai.intro}
  alternates={localizedAlternates('ai-engineering')}
  currentPath={localizedPath(locale, 'ai-engineering')}
>
  <section class="page-hero section-shell">
    <p class="eyebrow">{copy.ai.eyebrow}</p>
    <h1>{copy.ai.title}</h1>
    <p class="lede">{copy.ai.intro}</p>
  </section>
  <section class="section section-shell">
    <div class="capability-grid">
      {
        copy.ai.areas.map(([heading, text], index) => (
          <article>
            <>
              <span>0{index + 1}</span>
              <h2>{heading}</h2>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section section-shell evidence-index">
    <p class="eyebrow">{copy.ai.evidenceTitle}</p>
    <p class="section-intro">{copy.ai.evidenceIntro}</p>
    <div class="evidence-grid">
      {
        copy.ai.evidenceLinks.map(([heading, text], index) => {
          const paths = [
            'projects/enterprise-ai-assisted-engineering',
            'projects/nx-python-add-on-delivery',
            'projects/b2b-credit-management-ml-poc',
            'projects/ai-revenue-credit-operations',
            'projects/openscorecard',
          ];
          return (
            <a class="evidence-card" href={localizedPath(locale, paths[index])}>
              <span>0{index + 1}</span>
              <h2>{heading}</h2>
              <p>{text}</p>
            </a>
          );
        })
      }
    </div>
  </section>
  <section class="boundary-section section-shell">
    <p class="eyebrow">{copy.ai.boundaryLabel}</p>
    <h2>{copy.ai.boundaryTitle}</h2>
    <p>{copy.ai.boundary}</p>
    <div class="boundary-flow" aria-label={copy.ai.boundaryLabel}>
      {
        copy.ai.boundaryFlow.map((item, index) => (
          <>
            <span>{item}</span>
            {index < copy.ai.boundaryFlow.length - 1 && <b aria-hidden="true">→</b>}
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>
