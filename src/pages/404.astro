---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedAlternates } from '../i18n';
---

<BaseLayout
  locale="en"
  title="Page not found"
  description="The requested page does not exist."
  alternates={localizedAlternates()}
  currentPath="/404/"
  noIndex
>
  <section class="page-hero section-shell">
    <p class="eyebrow">404</p><h1>That route is outside the system.</h1><p class="lede">
      Return to the portfolio and continue from a known state.
    </p><a class="button primary" href="/">Return home</a>
  </section>
</BaseLayout>
